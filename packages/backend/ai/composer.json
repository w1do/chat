{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "vendor/ai",
    "description": "Self-hosted chat: ai backend package.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "illuminate/bus": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0",
        "php": "^8.4",
        "vendor/shared-kernel": "^0.1"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "vendor/identity": "^0.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../shared-kernel",
            "options": {
                "versions": {
                    "vendor/shared-kernel": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../identity",
            "options": {
                "versions": {
                    "vendor/identity": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Vendor\\Ai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vendor\\Ai\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vendor\\Ai\\AiServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
