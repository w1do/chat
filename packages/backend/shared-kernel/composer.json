{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "vendor/shared-kernel",
    "description": "Self-hosted chat: shared identifiers, contracts and stable value objects. No business rules.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "symfony/uid": "^7.0 || ^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": { "Vendor\\SharedKernel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Vendor\\SharedKernel\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable"
}
