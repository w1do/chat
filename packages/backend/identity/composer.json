{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "vendor/identity",
    "description": "Self-hosted chat: identity backend package.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "vendor/shared-kernel": "^0.1",
        "laravel/sanctum": "^4.0",
        "illuminate/auth": "^13.0",
        "illuminate/database": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../shared-kernel",
            "options": {
                "versions": {
                    "vendor/shared-kernel": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Vendor\\Identity\\": "src/",
            "Vendor\\Identity\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vendor\\Identity\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vendor\\Identity\\IdentityServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
