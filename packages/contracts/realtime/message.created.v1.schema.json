{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.chat.local/realtime/message.created.v1.schema.json",
  "title": "message.created.v1",
  "description": "Versioned real-time event payload for message.created.v1. Payload contains only data the subscriber is already authorized to read via the HTTP API.",
  "type": "object",
  "required": [
    "event",
    "version",
    "room_id",
    "occurred_at",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "message.created.v1"
    },
    "version": {
      "const": 1
    },
    "room_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "author",
        "body",
        "payload",
        "reply_to_id",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
        },
        "author": {
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
            },
            "name": {
              "type": "string",
              "maxLength": 255
            }
          }
        },
        "body": {
          "type": "string"
        },
        "reply_to_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "system"
          ]
        },
        "payload": {
          "type": [
            "object",
            "null"
          ],
          "description": "System event data (event, actor_id); null for ordinary messages.",
          "properties": {
            "event": {
              "type": "string",
              "enum": [
                "member.joined",
                "member.invited",
                "member.left",
                "member.removed"
              ]
            },
            "actor_id": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
