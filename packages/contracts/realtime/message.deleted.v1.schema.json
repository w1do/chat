{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.chat.local/realtime/message.deleted.v1.schema.json",
  "title": "message.deleted.v1",
  "description": "Versioned real-time event payload for message.deleted.v1. Payload contains only data the subscriber is already authorized to read via the HTTP API.",
  "type": "object",
  "required": ["event", "version", "room_id", "occurred_at", "data"],
  "additionalProperties": false,
  "properties": {
    "event": { "const": "message.deleted.v1" },
    "version": { "const": 1 },
    "room_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "required": ["id", "deleted_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$" },
        "deleted_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
