# =============================================================================
# Self-Hosted Chat — параметры окружения Docker Compose стека.
# Скопируйте в .env рядом с compose-файлами и заполните значения.
# Полный состав сервисов и compose-файлы появляются на этапе 2 (задача 2.2).
# =============================================================================

# --- Приложение ---
APP_NAME="Self-Hosted Chat"
# Секрет приложения: сгенерируйте `php artisan key:generate --show`. Не коммитить.
APP_KEY=
APP_URL=https://chat.example.com

# --- PostgreSQL ---
DB_DATABASE=chat
DB_USERNAME=chat
# Задайте стойкий пароль; не используйте значения по умолчанию в production.
DB_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Reverb (WebSocket) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Явный allowlist origin'ов; wildcard * запрещён в production.
REVERB_ALLOWED_ORIGINS=https://chat.example.com

# --- SMTP ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# --- AI-провайдер (внешняя интеграция за TextRevisionProvider) ---
AI_ENABLED=false
AI_PROVIDER=
# API-ключ провайдера: хранить только в environment/secrets manager.
AI_API_KEY=

# --- S3-совместимое хранилище (опционально) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
