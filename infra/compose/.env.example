# =============================================================================
# Self-Hosted Chat — параметры окружения Docker Compose стека.
# Скопируйте в .env рядом с compose-файлами и заполните значения.
# Полный состав сервисов и compose-файлы появляются на этапе 2 (задача 2.2).
# =============================================================================

# --- Приложение ---
APP_NAME="Self-Hosted Chat"
# Секрет приложения: сгенерируйте `php artisan key:generate --show`. Не коммитить.
APP_KEY=
APP_URL=https://chat.example.com

# --- PostgreSQL ---
DB_DATABASE=chat
DB_USERNAME=chat
# Задайте стойкий пароль; не используйте значения по умолчанию в production.
DB_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Reverb (WebSocket) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Явный allowlist origin'ов; wildcard * запрещён в production.
REVERB_ALLOWED_ORIGINS=https://chat.example.com

# --- SMTP ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# --- AI-провайдер (внешняя интеграция за TextRevisionProvider) ---
AI_ENABLED=false
# null (по умолчанию) либо polza
AI_PROVIDER=null
AI_BASE_URL=https://polza.ai/api/v1
AI_MODEL=openai/gpt-4o-mini
# API-ключ провайдера: хранить только в environment/secrets manager.
AI_API_KEY=
# Лимиты помощника
AI_MAX_INPUT_LENGTH=2000
AI_TIMEOUT_SECONDS=20
AI_PER_USER_MINUTE=6
AI_PER_USER_HOURLY=60

# --- S3-совместимое хранилище (опционально) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Образы приложения (закреплённые версии; latest запрещён) ---
CHAT_API_IMAGE=vendor/chat-api:0.1.0
CHAT_WEB_IMAGE=vendor/chat-web:0.1.0

# --- Порты proxy ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Публичный адрес WebSocket (для SPA; termination выполняет proxy) ---
REVERB_PUBLIC_HOST=chat.example.com
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https

# --- Push-уведомления (Web Push) ---
# php artisan chat:push-keys создаёт пару; пусто — push выключены.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Частота попыток входа ---
# Попыток в минуту с одного адреса; понижайте для публичной установки.
AUTH_LOGIN_PER_MINUTE=5
AUTH_REGISTER_PER_MINUTE=10
AUTH_PASSWORD_RESET_PER_MINUTE=5

# --- Typesense (поиск сообщений) ---
# Стойкий ключ API; не используйте значения по умолчанию в production.
TYPESENSE_API_KEY=
# Поиск по умолчанию выключен: чат работает и без него. Включив, задайте ключ
# выше и выполните `php artisan chat:search-reindex --fresh`.
SEARCH_ENABLED=false

# --- Octane ---
OCTANE_MAX_REQUESTS=500
