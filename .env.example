# Развёртывание семейного чата одной командой.
#
#   cp .env.example .env      # необязательно: значения по умолчанию рабочие
#   docker compose up -d --build
#
# В Dokploy эти же переменные задаются в разделе Environment.

# --- Адрес установки ---------------------------------------------------------
# APP_URL — полный адрес, по которому чат открывают в браузере.
# APP_DOMAIN — тот же адрес без схемы: по нему работает cookie-аутентификация.
APP_NAME="Семейный чат"
APP_URL=https://chat.example.com
APP_DOMAIN=chat.example.com
# true, когда чат открывается по https (обычный случай за Dokploy/Traefik).
SESSION_SECURE_COOKIE=true
# Порт публикуется только с оверлеем docker-compose.standalone.yml
# (голый VPS без панели). За Dokploy/Traefik он не используется.
HTTP_PORT=80
# Сеть балансировщика панели: через неё Traefik видит контейнер приложения.
# В Dokploy — dokploy-network; на голом VPS оверлей создаёт chat-proxy сам.
PROXY_NETWORK=dokploy-network
# Маршрут Traefik прописан в compose. Значения по умолчанию подходят Dokploy;
# меняйте, если у вашей панели другие entrypoint и резолвер сертификатов.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Ключ приложения ---------------------------------------------------------
# Оставьте пустым: при первом запуске ключ сгенерируется и сохранится в томе.
# Задавайте своё значение (base64:...), если переносите установку на другой хост.
APP_KEY=

# --- Секреты (обязательно смените для публичного сервера) --------------------
DB_DATABASE=chat
DB_USERNAME=chat
DB_PASSWORD=change-me-database
REDIS_PASSWORD=change-me-redis
REVERB_APP_ID=1001
REVERB_APP_KEY=change-me-public-key
REVERB_APP_SECRET=change-me-secret
TYPESENSE_API_KEY=change-me-typesense
# Origin'ы, которым разрешён WebSocket. Для публичной установки укажите домен.
REVERB_ALLOWED_ORIGINS=https://chat.example.com

# Клиент Redis: пусто — выбрать автоматически (phpredis, если расширение
# собралось, иначе predis). Задавайте явно только при необходимости.
REDIS_CLIENT=

# --- Push-уведомления (Web Push) ---
# Ключи генерируются один раз: docker compose exec api php artisan chat:push-keys
# Пусто — push выключены, остальные каналы уведомлений работают.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Частота попыток входа ---------------------------------------------------
# Попыток в минуту с одного адреса. Понижайте для публичной установки;
# поднимать имеет смысл только там, где за одним адресом много людей
# (офис, NAT) — иначе вы снимаете защиту от перебора.
AUTH_LOGIN_PER_MINUTE=5
AUTH_REGISTER_PER_MINUTE=10
AUTH_PASSWORD_RESET_PER_MINUTE=5
# Минимальная длина пароля. Одно число на сервер и на интерфейс: форма не
# бывает строже сервера. По умолчанию один символ — это семейный чат.
PASSWORD_MIN_LENGTH=1

# --- Поиск по сообщениям -----------------------------------------------------
SEARCH_ENABLED=true

# --- AI-помощник (необязательно) ---------------------------------------------
# Правит черновик по просьбе пользователя. Выключен — чат работает как обычно.
AI_ENABLED=false
AI_PROVIDER=polza
AI_BASE_URL=https://polza.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# --- Почта (необязательно) ---------------------------------------------------
# Нужна только для восстановления пароля и писем-уведомлений.
# log — письма пишутся в журнал контейнера, никуда не уходят.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=chat@example.com

# --- Тонкая настройка --------------------------------------------------------
OCTANE_MAX_REQUESTS=500
