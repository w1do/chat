############################################################
# Self‑Hosted Chat — .env (переменные из docker-compose.yml)
#
# По умолчанию значения совпадают со стандартными значениями
# из docker-compose.yml для быстрого локального запуска.
# Для production укажите свой домен, стойкие пароли и ключи.
############################################################

# ——— Домен и прокси ———
APP_NAME="Семейный чат"
APP_URL=http://localhost
APP_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# ——— Ключ приложения ———
# Пусто = сгенерируется автоматически при первом запуске (api: APP_BOOTSTRAP=true)
APP_KEY=

# ——— PostgreSQL ———
DB_DATABASE=chat
DB_USERNAME=chat
DB_PASSWORD=chat

# ——— Redis ———
REDIS_PASSWORD=chat
# Пусто = автовыбор (phpredis / predis)
REDIS_CLIENT=

# ——— CORS / Sanctum ———
CORS_ALLOWED_ORIGINS=http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost

# ——— Reverb (WebSocket) ———
REVERB_APP_ID=1001
REVERB_APP_KEY=chatkey
REVERB_APP_SECRET=chatsecret
REVERB_ALLOWED_ORIGINS=*

# ——— Параметры UI/лимиты ———
PASSWORD_MIN_LENGTH=1
AUTH_LOGIN_PER_MINUTE=5
AUTH_REGISTER_PER_MINUTE=10
AUTH_PASSWORD_RESET_PER_MINUTE=5
# Присутствие: сколько секунд после действия человек считается «в сети»
# и как редко его активность записывается в базу.
PRESENCE_ONLINE_WINDOW_SECONDS=120
PRESENCE_TOUCH_THROTTLE_SECONDS=60

# ——— Вложения ———
# До какого размера файла (КБ) миниатюра готовится прямо при загрузке.
# Файл крупнее готовится в очереди media, а приложение добирает миниатюру само.
ATTACHMENT_PREVIEW_SYNC_MAX_KB=4096

# ——— Typesense (поиск) ———
SEARCH_ENABLED=true
TYPESENSE_API_KEY=chat-typesense-key

# ——— Почта ———
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=chat@example.com
MAIL_FROM_NAME="Семейный чат"

# ——— Объектное хранилище (MinIO / S3) ———
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=chat
S3_SECRET_ACCESS_KEY=chat-secret
S3_BUCKET=chat
S3_REGION=us-east-1

# ——— Web Push (опционально) ———
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ——— AI (опционально) ———
AI_ENABLED=false
AI_PROVIDER=polza
AI_BASE_URL=https://polza.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
# Пересказ приложенного документа по ответу с «@ai».
# Предел файла, окно длины пересказа, таймаут и квоты.
AI_SUMMARY_MAX_FILE_KB=5120
AI_SUMMARY_MIN_LENGTH=500
AI_SUMMARY_MAX_LENGTH=800
AI_SUMMARY_TIMEOUT_SECONDS=40
AI_SUMMARY_PER_USER_HOURLY=20
AI_SUMMARY_PER_INSTALL_HOURLY=200
AI_SUMMARY_QUEUE=ai

# Одна тихая попытка восстановить истёкшую сессию (обновление CSRF-cookie и
# проверка /me) вместо экрана «Сессия истекла». Выключено по умолчанию:
# неверно настроенное восстановление прячет настоящий выход.
AUTH_SILENT_RECOVERY=false

# ——— Octane ———
OCTANE_MAX_REQUESTS=500

# ——— Образы (опционально переопределить) ———
# CHAT_API_IMAGE=chat-api:local
# CHAT_WEB_IMAGE=chat-web:local
