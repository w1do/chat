############################################################
# Self‑Hosted Chat — .env (только переменные из docker-compose.yml)
#
# Скопируйте как .env и укажите свои домены, пароли и ключи.
############################################################

# ——— Домен и прокси ———
APP_NAME="Семейный чат"
APP_URL=https://chat.example.com
APP_DOMAIN=chat.example.com
SESSION_SECURE_COOKIE=true
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# ——— Ключ приложения ———
# Пусто = сгенерируется при первом запуске (api: APP_BOOTSTRAP=true)
APP_KEY=base64:Bq85EhvZzZjz/IAVy0buqBj9YoqtfpvutCU4DHdtEiQ=

# ——— PostgreSQL ———
DB_DATABASE=chat
DB_USERNAME=chat
DB_PASSWORD=change-me-db

# ——— Redis ———
REDIS_PASSWORD=change-me-redis
REDIS_CLIENT=phpredis

# ——— CORS / Sanctum ———
CORS_ALLOWED_ORIGINS=https://chat.example.com
SANCTUM_STATEFUL_DOMAINS=chat.example.com

# ——— Reverb (WebSocket) ———
REVERB_APP_ID=1001
REVERB_APP_KEY=change-me-reverb-key
REVERB_APP_SECRET=change-me-reverb-secret
REVERB_ALLOWED_ORIGINS=https://chat.example.com

# ——— Параметры UI/лимиты ———
PASSWORD_MIN_LENGTH=8
AUTH_LOGIN_PER_MINUTE=5
AUTH_REGISTER_PER_MINUTE=10
AUTH_PASSWORD_RESET_PER_MINUTE=5

# ——— Typesense (поиск) ———
TYPESENSE_API_KEY=change-me-typesense

# ——— Почта ———
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=chat@example.com
MAIL_FROM_NAME="Семейный чат"

# ——— Объектное хранилище ———
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=chat
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_BUCKET=chat
S3_REGION=us-east-1

# ——— Web Push (опционально) ———
VAPID_PUBLIC_KEY=BOb0l_IMMzw9cfj7GbEGdk3kupziEElCpeDwdawhe4x58tFyX8DiU8Fz0OzYDPlkxTGKrqCpotAUhuw0uV0Emvw
VAPID_PRIVATE_KEY=2gipi_6Zcck93kndU2ip-vDPjvwBSpnNCFN1KHpf8Lg
VAPID_SUBJECT=mailto:admin@example.com

# ——— AI (опционально) ———
AI_ENABLED=true
AI_PROVIDER=polza
AI_BASE_URL=https://polza.ai/api/v1
AI_API_KEY=pza_gbscoEHvfUQwhWEpM305vxzXv82KByjL
AI_MODEL=openai/gpt-4o-mini

# ——— Octane ———
OCTANE_MAX_REQUESTS=500

# ——— Образы (опционально переопределить) ———
# CHAT_API_IMAGE=chat-api:local
# CHAT_WEB_IMAGE=chat-web:local
