############################################################
# Self‑Hosted Chat — пример .env
#
# Скопируйте этот файл как .env и при необходимости измените значения.
# Для production обязательно задайте собственные секреты и пароли.
############################################################

# ——— Базовые настройки приложения ———
APP_NAME="Семейный чат"
APP_ENV=production
APP_DEBUG=false
# Оставьте пустым: первый запуск сгенерирует ключ автоматически,
# либо задайте заранее (php artisan key:generate --show)
APP_KEY=

# Базовый публичный URL вашего чата (домен веб‑приложения)
APP_URL=https://chat.example.com
# Домен без схемы — нужен для CORS/Sanctum
APP_DOMAIN=chat.example.com

# Доверенные прокси (оставьте * за балансировщиком типа Traefik/Nginx)
TRUSTED_PROXIES=*

# ——— База данных PostgreSQL ———
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=chat
DB_USERNAME=chat
DB_PASSWORD=change-me-db

# ——— Redis (cache/queues/rate limiting/presence) ———
REDIS_HOST=redis
REDIS_PASSWORD=change-me-redis
# Пусто = авто‑выбор клиента (phpredis если доступен, иначе predis)
REDIS_CLIENT=

# ——— Хранилища и очереди ———
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

# Cookie сессии только по HTTPS в production
SESSION_SECURE_COOKIE=true

# ——— CORS и SPA‑аутентификация Sanctum ———
# Разрешённый origin фронтенда (обычно это APP_URL)
CORS_ALLOWED_ORIGINS=https://chat.example.com
# Домены, считающиеся «stateful» для Sanctum (через запятую)
SANCTUM_STATEFUL_DOMAINS=chat.example.com

# ——— Persistent browser token (Sanctum) ———
# Cookie‑токен для восстановления входа без PHP‑сессии
AUTH_BROWSER_TOKEN_ENABLED=true
AUTH_BROWSER_TOKEN_COOKIE=__Host-chat_browser_token
AUTH_BROWSER_TOKEN_ABILITY=browser
# TTL без «запомнить меня», минут (по умолчанию 1 сутки)
AUTH_BROWSER_TOKEN_TTL_MINUTES=1440
# TTL с «запомнить меня», минут (по умолчанию 30 дней)
AUTH_BROWSER_TOKEN_REMEMBER_TTL_MINUTES=43200
# В production должен быть true (Secure cookie)
AUTH_BROWSER_TOKEN_SECURE=true
# lax | strict | none (для разных поддоменов используйте none + Secure)
AUTH_BROWSER_TOKEN_SAME_SITE=lax
# Домен cookie. Для поддоменов можно .example.com; пусто = host‑only
AUTH_BROWSER_TOKEN_DOMAIN=

# ——— Reverb (WebSocket) ———
REVERB_APP_ID=1001
REVERB_APP_KEY=change-me-reverb-key
REVERB_APP_SECRET=change-me-reverb-secret
# Внешний доступ идёт через reverse proxy; внутренний хост/порт — сервис Reverb
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=reverb
REVERB_SERVER_PORT=8080
# В production задайте точный allowlist, wildcard * запрещён на бою
REVERB_ALLOWED_ORIGINS=https://chat.example.com

# ——— Email ———
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=chat@example.com
MAIL_FROM_NAME="Семейный чат"

# ——— Объектное хранилище (S3‑совместимое) ———
# Для внешнего S3 задайте свой endpoint и ключи; встроенный MinIO используется по умолчанию
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=chat
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_BUCKET=chat
S3_REGION=us-east-1

# ——— Поиск (Typesense) ———
SEARCH_ENABLED=true
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=change-me-typesense

# ——— Веб‑push уведомления (опционально) ———
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ——— AI (опционально) ———
AI_ENABLED=false
AI_PROVIDER=polza
AI_BASE_URL=https://polza.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# ——— Политики и лимиты ———
PASSWORD_MIN_LENGTH=8
AUTH_LOGIN_PER_MINUTE=5
AUTH_REGISTER_PER_MINUTE=10
AUTH_PASSWORD_RESET_PER_MINUTE=5

# ——— Octane / сервер приложений ———
OCTANE_SERVER=frankenphp
# OCTANE_MAX_REQUESTS можно задать через compose/окружение, если нужно

# ——— Настройки контейнерного reverse proxy (Traefik) ———
# Если разворачиваете через док‑панель с Traefik, оставьте значения по умолчанию
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
