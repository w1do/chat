#!/usr/bin/env bash
#
# ./tools/chat — единая точка входа для команд разработки монорепозитория.
# Подкоманды добавляются поэтапно вместе с задачами roadmap.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Проверки границ и статусов умеют работать против другого дерева: так их
# самопроверка убеждается, что нарушение действительно ловится.
CHECK_ROOT="${CHAT_CHECK_ROOT:-$ROOT}"
DOCS_DIR="${CHAT_DOCS_DIR:-$ROOT/docs/features}"
API_DIR="$ROOT/apps/chat-api"
BACKEND_PKGS=(shared-kernel identity chat notifications ai administration)

usage() {
  cat <<'EOF'
Usage: ./tools/chat <command> [args]

Commands:
  api <artisan-args…>     artisan в apps/chat-api (пример: ./tools/chat api about)
  web <script> [args…]    pnpm-скрипт в apps/chat-web (typecheck, build, test)
  test packages           изолированные тесты каждого backend-пакета
  test api                тесты apps/chat-api (Pest)
  check boundaries        запрет cross-package internal imports, deep imports,
                          правок сгенерированных файлов и Domain/ в apps
  check docs              статусы docs/features/* подтверждены командами проверки
  check selftest          проверки границ и статусов ловят подложенное нарушение
  ci                      полный локальный прогон того же, что и pull-request.yml
  contracts validate      валидация JSON Schema в packages/contracts
  lint | stan             pint / phpstan из корня
  openapi build           сборка openapi/dist/openapi.json из base + фрагментов пакетов
  openapi validate        проверка актуальности dist и структуры спецификации
  client generate         генерация packages/frontend/api-client/src/generated из dist
  compose config [prod|dev]  валидация compose-профилей (по умолчанию оба)
  build images            сборка production-образов api и web
  supervisor check        валидация синтаксиса infra/supervisor/*.conf
  deploy reload           graceful octane:reload + horizon:terminate + reverb:restart
  smoke runtime           HTTP/queue/WebSocket readiness против dev Compose стека
  smoke websocket         реальная доставка события через Reverb
  smoke search            индексация и поиск тестового сообщения в Typesense
  smoke polza             необязательная проверка настоящего AI (нужен AI_API_KEY)
  up | down               локальный полный стек в браузере (http://localhost:8088)
  smoke all               runtime + websocket + search (search — если поднят Typesense)
  e2e <spec> | e2e critical  Playwright: один сценарий или все критические
  e2e demo                smoke презентации demo.html (стек чата не нужен)
EOF
}

cmd="${1:-}"; shift || true

case "$cmd" in
  api)
    (cd "$API_DIR" && php artisan "$@")
    ;;
  web)
    if [[ "${1:-}" == "test" && -n "${2:-}" ]]; then
      (cd "$ROOT/packages/frontend/$2" && pnpm run test)
    else
      (cd "$ROOT/apps/chat-web" && pnpm run "$@")
    fi
    ;;
  test)
    sub="${1:-}"; shift || true
    case "$sub" in
      api)
        (cd "$API_DIR" && ./vendor/bin/pest "$@")
        ;;
      packages)
        rc=0
        for pkg in "${BACKEND_PKGS[@]}"; do
          dir="$ROOT/packages/backend/$pkg"
          if [[ ! -d "$dir/vendor" ]]; then
            echo "[skip] $pkg: vendor/ отсутствует — выполните composer install в $dir" >&2
            continue
          fi
          echo "== $pkg =="
          (cd "$dir" && composer test) || rc=1
        done
        exit $rc
        ;;
      chat-messages)
        (cd "$ROOT/packages/backend/chat" && ./vendor/bin/pest --filter "Message")
        ;;
      identity|chat|notifications|ai|administration|shared-kernel)
        (cd "$ROOT/packages/backend/$sub" && composer test)
        ;;
      *)
        echo "Unknown test target: $sub" >&2; exit 64
        ;;
    esac
    ;;
  check)
    sub="${1:-}"; shift || true
    case "$sub" in
      boundaries)
        rc=0
        # 1) Domain/ или Application/ внутри apps/* запрещены (STRUCTURE.md §9)
        if find "$CHECK_ROOT/apps" -type d \( -name Domain -o -name Application \) -not -path '*/vendor/*' | grep .; then
          echo "FAIL: Domain/ или Application/ внутри apps/*" >&2; rc=1
        fi
        # 2) cross-package internal imports: пакет не использует чужой Vendor\<Pkg>\ namespace,
        #    кроме shared-kernel (общий по контракту §4.1)
        declare -A NS=( [identity]=Identity [chat]=Chat [notifications]=Notifications [ai]=Ai [administration]=Administration )
        for pkg in "${!NS[@]}"; do
          for other in "${!NS[@]}"; do
            [[ "$pkg" == "$other" ]] && continue
            if grep -rn "Vendor\\\\${NS[$other]}\\\\" "$CHECK_ROOT/packages/backend/$pkg/src" 2>/dev/null; then
              echo "FAIL: $pkg импортирует внутренности $other" >&2; rc=1
            fi
          done
        done
        # 3) deep imports во frontend-пакетах: @vendor/<pkg>/src/... запрещены
        if grep -rn --include='*.ts' --include='*.tsx' -E "from ['\"]@vendor/[a-z-]+/src/" \
            "$CHECK_ROOT/packages/frontend" "$CHECK_ROOT/apps/chat-web/src" 2>/dev/null; then
          echo "FAIL: deep import @vendor/*/src/**" >&2; rc=1
        fi
        # 4) сгенерированные файлы не правят руками: dist OpenAPI и клиент
        #    должны совпадать с результатом генерации.
        if [[ "$CHECK_ROOT" == "$ROOT" ]]; then
          if ! (cd "$API_DIR" && php openapi/build.php --check >/dev/null); then
            echo "FAIL: openapi/dist отличается от сборки — перегенерируйте" >&2; rc=1
          fi
          before="$(sha1sum "$ROOT/packages/frontend/api-client/src/generated/schema.d.ts" | cut -d" " -f1)"
          (cd "$ROOT/packages/frontend/api-client" && pnpm run generate >/dev/null 2>&1) || true
          after="$(sha1sum "$ROOT/packages/frontend/api-client/src/generated/schema.d.ts" | cut -d" " -f1)"
          if [[ "$before" != "$after" ]]; then
            echo "FAIL: generated-клиент отличается от dist — закоммитьте перегенерацию" >&2; rc=1
          fi
        fi
        [[ $rc -eq 0 ]] && echo "boundaries: OK"
        exit $rc
        ;;
      docs)
        # Статус implemented/verified подтверждается командой проверки, которую
        # можно выполнить: иначе документация обгоняет код (CLAUDE.md §16).
        rc=0
        shopt -s nullglob
        for doc in "$DOCS_DIR"/*.md; do
          status="$(grep -m1 '^Статус:' "$doc" | sed 's/^Статус: *//')"
          name="$(basename "$doc")"
          case "$status" in
            planned*|'in progress'*)
              continue
              ;;
            implemented*|verified*)
              if ! grep -q '`\./tools/chat ' "$doc"; then
                echo "FAIL: $name заявляет «$status», но не называет команду проверки" >&2; rc=1
                continue
              fi
              # Каждая названная подкоманда должна существовать в этом файле.
              while read -r target; do
                [[ -z "$target" ]] && continue
                if ! grep -q "^  $target)" "$ROOT/tools/chat" && ! grep -q "^      $target)" "$ROOT/tools/chat"; then
                  echo "FAIL: $name ссылается на несуществующую команду «chat $target»" >&2; rc=1
                fi
              done < <(grep -o '`\./tools/chat [a-z0-9-]*' "$doc" | awk '{print $2}' | sort -u)
              if [[ "$status" == verified* ]] && ! grep -qE '`\./tools/chat (e2e|smoke) ' "$doc"; then
                echo "FAIL: $name заявляет «verified» без E2E или smoke-команды" >&2; rc=1
              fi
              ;;
            *)
              echo "FAIL: $name без распознанного статуса" >&2; rc=1
              ;;
          esac
        done
        shopt -u nullglob
        [[ $rc -eq 0 ]] && echo "docs status: OK"
        exit $rc
        ;;
      selftest)
        # Проверки бесполезны, если не падают на нарушении: подкладываем его
        # во временное дерево и требуем ненулевой код возврата.
        tmp="$(mktemp -d)"
        trap 'rm -rf "$tmp"' EXIT
        rc=0

        mkdir -p "$tmp/apps/chat-api/app/Domain" "$tmp/packages/backend/chat/src" \
                 "$tmp/packages/frontend/chat/src" "$tmp/apps/chat-web/src"
        if CHAT_CHECK_ROOT="$tmp" "$0" check boundaries >/dev/null 2>&1; then
          echo "FAIL: Domain/ внутри apps/* не пойман" >&2; rc=1
        fi

        rm -rf "$tmp/apps/chat-api/app/Domain"
        printf '<?php use Vendor\\Identity\\Domain\\Models\\User;' > "$tmp/packages/backend/chat/src/Leak.php"
        if CHAT_CHECK_ROOT="$tmp" "$0" check boundaries >/dev/null 2>&1; then
          echo "FAIL: cross-package import не пойман" >&2; rc=1
        fi

        rm -f "$tmp/packages/backend/chat/src/Leak.php"
        printf "import { x } from '@vendor/ui/src/internal';" > "$tmp/apps/chat-web/src/deep.ts"
        if CHAT_CHECK_ROOT="$tmp" "$0" check boundaries >/dev/null 2>&1; then
          echo "FAIL: deep import не пойман" >&2; rc=1
        fi

        docs="$tmp/docs"
        mkdir -p "$docs"
        printf '# Ложный статус\n\nСтатус: implemented\n' > "$docs/fake.md"
        if CHAT_DOCS_DIR="$docs" "$0" check docs >/dev/null 2>&1; then
          echo "FAIL: статус implemented без команды проверки не пойман" >&2; rc=1
        fi

        printf '# Ложный verified\n\nСтатус: verified\n\n`./tools/chat test api`\n' > "$docs/fake.md"
        if CHAT_DOCS_DIR="$docs" "$0" check docs >/dev/null 2>&1; then
          echo "FAIL: статус verified без E2E/smoke не пойман" >&2; rc=1
        fi

        printf '# Несуществующая команда\n\nСтатус: implemented\n\n`./tools/chat frobnicate`\n' > "$docs/fake.md"
        if CHAT_DOCS_DIR="$docs" "$0" check docs >/dev/null 2>&1; then
          echo "FAIL: ссылка на несуществующую команду не поймана" >&2; rc=1
        fi

        [[ $rc -eq 0 ]] && echo "check selftest: OK (все нарушения пойманы)"
        exit $rc
        ;;
      *)
        echo "Unknown check: $sub" >&2; exit 64
        ;;
    esac
    ;;
  contracts)
    sub="${1:-}"; shift || true
    if [[ "$sub" == "validate" ]]; then
      php -r '
        $ok = true;
        foreach (glob($argv[1]."/packages/contracts/realtime/*.schema.json") as $f) {
            $data = json_decode((string) file_get_contents($f));
            if ($data === null) { fwrite(STDERR, "FAIL: $f\n"); $ok = false; continue; }
            foreach (["\$schema", "\$id", "title", "type", "required", "properties"] as $k) {
                if (!property_exists($data, $k)) { fwrite(STDERR, "FAIL: $f missing $k\n"); $ok = false; }
            }
            echo basename($f), ": OK\n";
        }
        exit($ok ? 0 : 1);
      ' "$ROOT"
    else
      echo "Unknown contracts command: $sub" >&2; exit 64
    fi
    ;;
  openapi)
    sub="${1:-}"; shift || true
    case "$sub" in
      build)
        (cd "$API_DIR" && php openapi/build.php)
        ;;
      validate)
        (cd "$API_DIR" && php openapi/build.php --check)
        php -r '
          $spec = json_decode((string) file_get_contents($argv[1]), true);
          if (!is_array($spec)) { fwrite(STDERR, "dist is not valid JSON\n"); exit(1); }
          foreach (["openapi", "info", "paths"] as $k) {
              if (!array_key_exists($k, $spec)) { fwrite(STDERR, "missing key: $k\n"); exit(1); }
          }
          if (!str_starts_with((string) $spec["openapi"], "3.1")) { fwrite(STDERR, "not OpenAPI 3.1\n"); exit(1); }
          foreach ($spec["paths"] as $p => $ops) {
              if (!str_starts_with($p, "/")) { fwrite(STDERR, "invalid path: $p\n"); exit(1); }
          }
          echo "openapi validate: OK\n";
        ' "$API_DIR/openapi/dist/openapi.json"
        ;;
      *)
        echo "Unknown openapi command: $sub" >&2; exit 64
        ;;
    esac
    ;;
  client)
    sub="${1:-}"; shift || true
    [[ "$sub" == "generate" ]] || { echo "Unknown client command: $sub" >&2; exit 64; }
    (cd "$ROOT/packages/frontend/api-client" && pnpm run generate)
    ;;
  compose)
    sub="${1:-}"; shift || true
    [[ "$sub" == "config" ]] || { echo "Unknown compose command: $sub" >&2; exit 64; }
    cd "$ROOT/infra/compose"
    envfile=".env"
    if [[ ! -f .env ]]; then
      cp .env.example .env.compose-check
      envfile=".env.compose-check"
    fi
    profiles="${1:-both}"
    rc=0
    if [[ "$profiles" == "prod" || "$profiles" == "both" ]]; then
      # Профиля s3 больше нет: хранилище — обязательный сервис (ADR-011).
      echo "== compose.prod.yaml =="
      DB_PASSWORD="${DB_PASSWORD:-check}" REDIS_PASSWORD="${REDIS_PASSWORD:-check}" \
      REVERB_APP_KEY="${REVERB_APP_KEY:-check}" TYPESENSE_API_KEY="${TYPESENSE_API_KEY:-check}" \
      S3_ACCESS_KEY_ID="${S3_ACCESS_KEY_ID:-check}" S3_SECRET_ACCESS_KEY="${S3_SECRET_ACCESS_KEY:-check-secret}" \
        docker compose --env-file "$envfile" -f compose.prod.yaml config -q && echo OK || rc=1
    fi
    if [[ "$profiles" == "dev" || "$profiles" == "both" ]]; then
      echo "== compose.dev.yaml =="
      docker compose -f compose.dev.yaml config -q && echo OK || rc=1
    fi
    rm -f .env.compose-check
    exit $rc
    ;;
  build)
    sub="${1:-}"; shift || true
    [[ "$sub" == "images" ]] || { echo "Unknown build command: $sub" >&2; exit 64; }
    docker build -f "$ROOT/infra/docker/api/Dockerfile" -t vendor/chat-api:0.1.0 "$ROOT"
    docker build -f "$ROOT/infra/docker/web/Dockerfile" -t vendor/chat-web:0.1.0 "$ROOT"
    ;;
  supervisor)
    sub="${1:-}"; shift || true
    [[ "$sub" == "check" ]] || { echo "Unknown supervisor command: $sub" >&2; exit 64; }
    python3 - "$ROOT/infra/supervisor" <<'PY'
import configparser, glob, sys

root = sys.argv[1]
ok = True
required = {"autostart", "autorestart", "stopasgroup", "killasgroup", "user"}
for path in sorted(glob.glob(root + "/*.conf")):
    cp = configparser.ConfigParser(strict=True, interpolation=None)
    try:
        cp.read(path)
    except configparser.Error as e:
        print(f"FAIL {path}: {e}"); ok = False; continue
    for section in cp.sections():
        if section.startswith("program:"):
            missing = required - set(cp[section])
            if missing:
                print(f"FAIL {path} [{section}]: missing {sorted(missing)}"); ok = False
    print(f"OK   {path}")
sys.exit(0 if ok else 1)
PY
    ;;
  deploy)
    sub="${1:-}"; shift || true
    [[ "$sub" == "reload" ]] || { echo "Unknown deploy command: $sub" >&2; exit 64; }
    # Graceful reload после deploy: новый код подхватывается без drop'а трафика.
    # В Compose команды выполняются в работающих контейнерах; на Linux/VM — напрямую.
    if docker compose -p chat ps -q api >/dev/null 2>&1 && [[ -n "$(docker compose -p chat ps -q api 2>/dev/null)" ]]; then
      docker compose -p chat exec api php artisan octane:reload
      docker compose -p chat exec worker php artisan horizon:terminate
      docker compose -p chat exec reverb php artisan reverb:restart
    else
      (cd "$API_DIR" && php artisan octane:reload && php artisan horizon:terminate && php artisan reverb:restart)
    fi
    ;;
  smoke)
    sub="${1:-}"; shift || true
    if [[ "$sub" == "octane" ]]; then
      # Утечка identity между последовательными запросами одного FrankenPHP worker'а
      # (--workers=1): регистрируем двух пользователей, чередуем /me по их cookie.
      api_url="${CHAT_API_URL:-http://127.0.0.1:8000}"
      ref="${CHAT_SPA_REFERER:-http://127.0.0.1:8000}"
      jar_a=$(mktemp) jar_b=$(mktemp)
      suffix=$RANDOM$RANDOM
      xsrf() { # $1=jar → печатает актуальный XSRF-токен (url-декодированный)
        awk '$6 == "XSRF-TOKEN" {v=$7} END {print v}' "$1" | python3 -c 'import sys,urllib.parse; print(urllib.parse.unquote(sys.stdin.read().strip()))'
      }
      spa_post() { # $1=jar $2=path $3=json
        curl -fsS -b "$1" -c "$1" -X POST "$api_url$2" -H 'Content-Type: application/json' -H 'Accept: application/json' \
          -H "Referer: $ref" -H "X-XSRF-TOKEN: $(xsrf "$1")" -d "$3"
      }
      for jar in "$jar_a" "$jar_b"; do
        curl -fsS -c "$jar" "$api_url/sanctum/csrf-cookie" -H "Referer: $ref" -o /dev/null
      done
      spa_post "$jar_a" /api/v1/auth/register "{\"name\":\"Alice\",\"email\":\"alice$suffix@example.com\",\"password\":\"octane-smoke-pass1\"}" >/dev/null
      spa_post "$jar_b" /api/v1/auth/register "{\"name\":\"Bob\",\"email\":\"bob$suffix@example.com\",\"password\":\"octane-smoke-pass1\"}" >/dev/null
      rc=0
      for i in 1 2 3; do
        a=$(curl -fsS -b "$jar_a" -c "$jar_a" "$api_url/api/v1/me" -H 'Accept: application/json' -H "Referer: $ref" | grep -o '"name":"[^"]*"' | head -1)
        b=$(curl -fsS -b "$jar_b" -c "$jar_b" "$api_url/api/v1/me" -H 'Accept: application/json' -H "Referer: $ref" | grep -o '"name":"[^"]*"' | head -1)
        echo "round $i: A=$a B=$b"
        [[ "$a" == '"name":"Alice"' && "$b" == '"name":"Bob"' ]] || rc=1
      done
      rm -f "$jar_a" "$jar_b"
      [[ $rc -eq 0 ]] && echo "smoke octane: OK (no identity leak)" || echo "smoke octane: FAIL"
      exit $rc
    fi
    if [[ "$sub" == "websocket" ]]; then
      # Реальная доставка события: publish через pusher-протокол Reverb →
      # получение по WebSocket node-клиентом (pusher-js).
      ws_host="${REVERB_SMOKE_HOST:-127.0.0.1}" ws_port="${REVERB_SMOKE_PORT:-8080}"
      node "$ROOT/tools/smoke-websocket.mjs" "$ws_host" "$ws_port" "${REVERB_APP_KEY:-devkey}" &
      listener=$!
      sleep 2
      php -r '
        require $argv[1]."/apps/chat-api/vendor/autoload.php";
        // Ключи берутся из окружения: смоук работает и против dev-стека,
        // и против production-профиля с собственными секретами.
        $pusher = new Pusher\Pusher($argv[4], $argv[5], $argv[6], [
            "host" => $argv[2], "port" => (int) $argv[3], "scheme" => "http", "useTLS" => false,
        ]);
        $pusher->trigger("smoke-channel", "smoke.event.v1", ["ok" => true, "sent_at" => date("c")]);
        echo "event published\n";
      ' "$ROOT" "$ws_host" "$ws_port" "${REVERB_APP_KEY:-devkey}" "${REVERB_APP_SECRET:-devsecret}" "${REVERB_APP_ID:-1001}"
      wait $listener
      exit $?
    fi
    if [[ "$sub" == "storage" ]]; then
      # Реальный MinIO из dev-стека: бакет создаётся идемпотентно, затем
      # пробный объект пишется, читается, сверяется и удаляется (ADR-011).
      (cd "$API_DIR" && \
        S3_ENDPOINT="${S3_SMOKE_ENDPOINT:-http://127.0.0.1:${S3_PORT:-9000}}" \
        S3_ACCESS_KEY_ID="${S3_ACCESS_KEY_ID:-dev}" \
        S3_SECRET_ACCESS_KEY="${S3_SECRET_ACCESS_KEY:-dev-secret}" \
        S3_BUCKET="${S3_BUCKET:-chat}" \
        sh -c 'php artisan storage:ensure-bucket && php artisan storage:smoke')
      exit $?
    fi
    if [[ "$sub" == "all" ]]; then
      rc=0
      for target in runtime websocket storage search; do
        echo "== smoke $target =="
        "$0" smoke "$target" || rc=1
      done
      [[ $rc -eq 0 ]] && echo "smoke all: OK" || echo "smoke all: FAIL"
      exit $rc
    fi
    if [[ "$sub" == "search" ]]; then
      # Реальный Typesense из dev-стека: создаём коллекцию, индексируем
      # документ и находим его. Индекс всегда перестраиваем, поэтому смоук
      # безопасно оставляет за собой удалённый документ.
      (cd "$API_DIR" && SEARCH_ENABLED=true \
        TYPESENSE_HOST="${TYPESENSE_SMOKE_HOST:-127.0.0.1}" \
        TYPESENSE_PORT="${TYPESENSE_PORT:-8108}" \
        TYPESENSE_API_KEY="${TYPESENSE_API_KEY:-dev-typesense-key}" \
        SEARCH_COLLECTION="${SEARCH_COLLECTION:-messages-smoke}" \
        php artisan tinker --execute='
          $index = app(Vendor\Chat\Domain\Contracts\MessageIndex::class);
          $index->recreateCollection();
          $id = (string) Illuminate\Support\Str::ulid();
          $index->index(new Vendor\Chat\Domain\ValueObjects\IndexedMessage(
              id: $id, roomId: "smoke-room", authorId: "smoke-author",
              body: "борщ по бабушкиному рецепту", createdAt: time(),
          ));
          usleep(300000);
          $hits = $index->search("борщ", ["smoke-room"], 5);
          $index->remove($id);
          if (! in_array($id, $hits, true)) {
              echo "smoke search: FAIL (документ не найден)", PHP_EOL; exit(1);
          }
          echo "smoke search: OK (проиндексирован и найден)", PHP_EOL;
        ')
      exit $?
    fi
    if [[ "$sub" == "polza" ]]; then
      # Необязательная проверка против настоящего Polza AI: включается только
      # при заданном ключе, обычный CI её не запускает (CLAUDE.md §13).
      if [[ -z "${AI_API_KEY:-}" ]]; then
        echo "smoke polza: SKIP (AI_API_KEY не задан)"
        exit 0
      fi
      (cd "$API_DIR" && AI_ENABLED=true AI_PROVIDER=polza php artisan tinker --execute='
        $handler = app(Vendor\Ai\Application\Handlers\Commands\ReviseDraftHandler::class);
        $user = config("auth.providers.users.model")::query()->firstOrFail();
        $result = $handler->handle(new Vendor\Ai\Application\Commands\ReviseDraftCommand(
            userId: (string) $user->getKey(), operation: "fix", text: "привет как дила",
        ));
        echo "provider=", $result->provider, " model=", $result->model, PHP_EOL;
        echo "suggestion=", mb_substr($result->suggestion, 0, 120), PHP_EOL;
      ')
      exit $?
    fi
    [[ "$sub" == "runtime" ]] || { echo "Unknown smoke target: $sub" >&2; exit 64; }
    # Readiness против dev-стека: HTTP liveness/readiness API + компоненты из readiness payload.
    api_url="${CHAT_API_URL:-http://127.0.0.1:8000}"
    rc=0
    echo "== HTTP liveness =="
    curl -fsS -m 5 "$api_url/up" >/dev/null && echo "up: OK" || { echo "up: FAIL"; rc=1; }
    echo "== readiness =="
    body="$(curl -fsS -m 10 "$api_url/api/v1/readiness" || true)"
    echo "$body"
    [[ -n "$body" ]] || { echo "readiness: FAIL"; rc=1; }
    for compo in database redis queue websocket storage; do
      echo "$body" | grep -q "\"$compo\":{\"status\":\"ok\"" || { echo "$compo: not ok"; rc=1; }
    done
    [[ $rc -eq 0 ]] && echo "smoke runtime: OK"
    exit $rc
    ;;
  e2e)
    sub="${1:-realtime}"; shift || true
    if [[ "$sub" == "demo" ]]; then
      # Презентация самодостаточна: страница отдаётся браузеру перехватом
      # маршрута, поэтому ни стек чата, ни static server не нужны.
      docker run --rm -e CI=true \
        -v "$ROOT":/repo -v /home/dev/.local/share/pnpm/store/v3:/pnpm-store -w /repo/apps/chat-web \
        mcr.microsoft.com/playwright:v1.58.1-noble \
        bash -c "corepack enable >/dev/null 2>&1; corepack prepare pnpm@9.12.3 --activate >/dev/null 2>&1; pnpm exec playwright test e2e/demo-landing.spec.ts --reporter=line"
      exit $?
    fi
    if [[ "$sub" == "critical" ]]; then
      # Критические сценарии релиза: регистрация, переписка двоих, real-time,
      # помощник, уведомление о пропущенном, поиск, управление комнатой,
      # состав комнаты (приглашение по нику и исключение), изображения
      # профиля, вложения к сообщениям и мобильная раскладка панели ввода
      # с приглашением.
      "$0" e2e-stack-up
      docker run --rm --network chat-dev_default -e E2E_BASE_URL=http://proxy -e CI=true \
        -v "$ROOT":/repo -v /home/dev/.local/share/pnpm/store/v3:/pnpm-store -w /repo/apps/chat-web \
        mcr.microsoft.com/playwright:v1.58.1-noble \
        bash -c "corepack enable >/dev/null 2>&1; corepack prepare pnpm@9.12.3 --activate >/dev/null 2>&1; pnpm exec playwright test e2e/auth.spec.ts e2e/messaging.spec.ts e2e/realtime.spec.ts e2e/ai-revision.spec.ts e2e/desktop.spec.ts e2e/invite.spec.ts e2e/room-management.spec.ts e2e/membership.spec.ts e2e/profile-images.spec.ts e2e/attachments.spec.ts e2e/direct-messages.spec.ts e2e/mobile-composer.spec.ts --reporter=line"
      rc=$?
      "$0" e2e-stack-down
      exit $rc
    fi
    # E2E-стек: postgres+redis (dev compose) + api/reverb/web + smoke-proxy,
    # Playwright — в официальном контейнере с браузерами (адрес внутри сети).
    "$0" e2e-stack-up
    docker run --rm --network chat-dev_default -e E2E_BASE_URL=http://proxy -e CI=true       -v "$ROOT":/repo -v /home/dev/.local/share/pnpm/store/v3:/pnpm-store -w /repo/apps/chat-web       mcr.microsoft.com/playwright:v1.58.1-noble       bash -c "corepack enable >/dev/null 2>&1; corepack prepare pnpm@9.12.3 --activate >/dev/null 2>&1; pnpm exec playwright test e2e/$sub.spec.ts --reporter=line"
    rc=$?
    "$0" e2e-stack-down
    exit $rc
    ;;
  ci)
    # Тот же порядок шагов, что в .github/workflows/pull-request.yml.
    rc=0
    step() {
      echo "== $1 =="
      shift
      if "$@"; then echo "OK"; else echo "FAIL"; rc=1; fi
    }
    step "pint" "$ROOT/vendor/bin/pint" --test packages apps/chat-api/app apps/chat-api/tests
    step "phpstan" "$0" stan
    step "package tests" "$0" test packages
    step "application tests" "$0" test api
    step "frontend typecheck" "$0" web typecheck
    step "frontend build" "$0" web build
    # Все frontend-пакеты со своими тестами: пропуск пакета — это тест,
    # который никого не держит.
    for pkg in chat identity notifications ui; do
      step "frontend tests: $pkg" "$0" web test "$pkg"
    done
    step "frontend tests: chat-web" "$0" web test
    step "contracts" "$0" contracts validate
    step "openapi" "$0" openapi validate
    step "boundaries" "$0" check boundaries
    step "docs status" "$0" check docs
    step "check selftest" "$0" check selftest
    step "compose config" "$0" compose config
    step "supervisor" "$0" supervisor check
    [[ $rc -eq 0 ]] && echo "ci: OK" || echo "ci: FAIL"
    exit $rc
    ;;
  up)
    # Полный локальный стек для ручной проверки в браузере.
    "$0" e2e-stack-up
    ;;
  down)
    "$0" e2e-stack-down
    docker compose -f "$ROOT/infra/compose/compose.dev.yaml" down >/dev/null 2>&1 || true
    echo "stack down"
    ;;
  e2e-stack-up)
    docker compose -f "$ROOT/infra/compose/compose.dev.yaml" up -d postgres redis typesense minio >/dev/null
    sleep 3
    APPKEY=$(cd "$API_DIR" && php artisan key:generate --show)
    common="-e APP_KEY=$APPKEY -e APP_ENV=production -e APP_DEBUG=false -e OCTANE_SERVER=frankenphp       -e DB_CONNECTION=pgsql -e DB_HOST=postgres -e DB_DATABASE=chat -e DB_USERNAME=chat -e DB_PASSWORD=chat       -e REDIS_HOST=redis -e CACHE_STORE=redis -e SESSION_DRIVER=redis -e QUEUE_CONNECTION=redis       -e SESSION_SECURE_COOKIE=false -e SANCTUM_STATEFUL_DOMAINS=proxy,localhost:${CHAT_LOCAL_PORT:-8088},127.0.0.1:${CHAT_LOCAL_PORT:-8088} -e CORS_ALLOWED_ORIGINS=http://proxy,http://localhost:${CHAT_LOCAL_PORT:-8088}       -e BROADCAST_CONNECTION=reverb -e REVERB_APP_ID=1001 -e REVERB_APP_KEY=devkey -e REVERB_APP_SECRET=devsecret       -e REVERB_SERVER_HOST=reverb -e REVERB_SERVER_PORT=8080 -e REVERB_HOST=reverb -e REVERB_PORT=8080       -e REVERB_SCHEME=http -e REVERB_ALLOWED_ORIGINS=*       -e AUTH_REGISTER_PER_MINUTE=200 -e AUTH_LOGIN_PER_MINUTE=200       -e SEARCH_ENABLED=true -e TYPESENSE_HOST=typesense -e TYPESENSE_PORT=8108 -e TYPESENSE_API_KEY=dev-typesense-key       -e S3_ENDPOINT=http://minio:9000 -e S3_ACCESS_KEY_ID=dev -e S3_SECRET_ACCESS_KEY=dev-secret -e S3_BUCKET=chat"
    docker rm -f e2e-api e2e-reverb e2e-worker e2e-web e2e-proxy >/dev/null 2>&1 || true
    docker run -d --name e2e-api --network chat-dev_default --network-alias api $common vendor/chat-api:0.1.0 >/dev/null
    docker run -d --name e2e-reverb --network chat-dev_default --network-alias reverb $common vendor/chat-api:0.1.0 php artisan reverb:start --host=0.0.0.0 --port=8080 >/dev/null
    # Broadcast'ы ставятся в очередь (QUEUE_CONNECTION=redis) — нужен worker.
    docker run -d --name e2e-worker --network chat-dev_default $common vendor/chat-api:0.1.0 php artisan queue:work --queue=default,search,notifications,notifications-bulk,notifications-critical,media --tries=1 >/dev/null
    docker run -d --name e2e-web --network chat-dev_default --network-alias web       -e API_BASE_URL=/api/v1 -e REVERB_HOST="${CHAT_WS_HOST:-}" -e REVERB_PORT="${CHAT_WS_PORT:-}" -e REVERB_SCHEME="" -e REVERB_APP_KEY=devkey       -e AI_ENABLED=false -e APP_NAME="E2E Chat" vendor/chat-web:0.1.0 >/dev/null
    docker run -d --name e2e-proxy --network chat-dev_default --network-alias proxy \
      -p "${CHAT_LOCAL_PORT:-8088}:80" \
      -v "$ROOT/infra/docker/proxy/Caddyfile.smoke:/etc/caddy/Caddyfile:ro" caddy:2.10.0-alpine >/dev/null
    sleep 6
    docker run --rm --network chat-dev_default $common vendor/chat-api:0.1.0 php artisan migrate --force >/dev/null
    # Бакет хранилища — часть установки: создаётся идемпотентно (ADR-011).
    docker run --rm --network chat-dev_default $common vendor/chat-api:0.1.0 php artisan storage:ensure-bucket >/dev/null
    # Коллекция поиска создаётся сразу: индекс всегда перестраиваем из PostgreSQL.
    docker run --rm --network chat-dev_default $common vendor/chat-api:0.1.0 php artisan chat:search-reindex >/dev/null
    echo "stack up: http://localhost:${CHAT_LOCAL_PORT:-8088} (proxy alias 'proxy' в сети chat-dev_default)"
    ;;
  e2e-stack-down)
    docker rm -f e2e-api e2e-reverb e2e-worker e2e-web e2e-proxy >/dev/null 2>&1 || true
    echo "e2e stack down"
    ;;
  lint)
    (cd "$ROOT" && ./vendor/bin/pint --test "$@")
    ;;
  stan)
    (cd "$ROOT" && apps/chat-api/vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G "$@")
    ;;
  ""|help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 64
    ;;
esac
