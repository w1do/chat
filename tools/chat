#!/usr/bin/env bash
#
# ./tools/chat — единая точка входа для команд разработки монорепозитория.
# Подкоманды добавляются поэтапно вместе с задачами roadmap.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
API_DIR="$ROOT/apps/chat-api"
BACKEND_PKGS=(shared-kernel identity chat notifications ai administration)

usage() {
  cat <<'EOF'
Usage: ./tools/chat <command> [args]

Commands:
  api <artisan-args…>     artisan в apps/chat-api (пример: ./tools/chat api about)
  web <script> [args…]    pnpm-скрипт в apps/chat-web (typecheck, build, test)
  test packages           изолированные тесты каждого backend-пакета
  test api                тесты apps/chat-api (Pest)
  check boundaries        запрет cross-package internal imports и Domain/ в apps
  contracts validate      валидация JSON Schema в packages/contracts
  lint | stan             pint / phpstan из корня
  openapi build           сборка openapi/dist/openapi.json из base + фрагментов пакетов
  openapi validate        проверка актуальности dist и структуры спецификации
  client generate         генерация packages/frontend/api-client/src/generated из dist
  compose config [prod|dev]  валидация compose-профилей (по умолчанию оба)
  build images            сборка production-образов api и web
  supervisor check        валидация синтаксиса infra/supervisor/*.conf
  deploy reload           graceful octane:reload + horizon:terminate + reverb:restart
  smoke runtime           HTTP/queue/WebSocket readiness против dev Compose стека
  smoke websocket         реальная доставка события через Reverb
  up | down               локальный полный стек в браузере (http://localhost:8088)
  e2e <spec>              Playwright-сценарий против локального стека
EOF
}

cmd="${1:-}"; shift || true

case "$cmd" in
  api)
    (cd "$API_DIR" && php artisan "$@")
    ;;
  web)
    if [[ "${1:-}" == "test" && -n "${2:-}" ]]; then
      (cd "$ROOT/packages/frontend/$2" && pnpm run test)
    else
      (cd "$ROOT/apps/chat-web" && pnpm run "$@")
    fi
    ;;
  test)
    sub="${1:-}"; shift || true
    case "$sub" in
      api)
        (cd "$API_DIR" && ./vendor/bin/pest "$@")
        ;;
      packages)
        rc=0
        for pkg in "${BACKEND_PKGS[@]}"; do
          dir="$ROOT/packages/backend/$pkg"
          if [[ ! -d "$dir/vendor" ]]; then
            echo "[skip] $pkg: vendor/ отсутствует — выполните composer install в $dir" >&2
            continue
          fi
          echo "== $pkg =="
          (cd "$dir" && composer test) || rc=1
        done
        exit $rc
        ;;
      chat-messages)
        (cd "$ROOT/packages/backend/chat" && ./vendor/bin/pest --filter "Message")
        ;;
      identity|chat|notifications|ai|administration|shared-kernel)
        (cd "$ROOT/packages/backend/$sub" && composer test)
        ;;
      *)
        echo "Unknown test target: $sub" >&2; exit 64
        ;;
    esac
    ;;
  check)
    sub="${1:-}"; shift || true
    case "$sub" in
      boundaries)
        rc=0
        # 1) Domain/ или Application/ внутри apps/* запрещены (STRUCTURE.md §9)
        if find "$ROOT/apps" -type d \( -name Domain -o -name Application \) -not -path '*/vendor/*' | grep .; then
          echo "FAIL: Domain/ или Application/ внутри apps/*" >&2; rc=1
        fi
        # 2) cross-package internal imports: пакет не использует чужой Vendor\<Pkg>\ namespace,
        #    кроме shared-kernel (общий по контракту §4.1)
        declare -A NS=( [identity]=Identity [chat]=Chat [notifications]=Notifications [ai]=Ai [administration]=Administration )
        for pkg in "${!NS[@]}"; do
          for other in "${!NS[@]}"; do
            [[ "$pkg" == "$other" ]] && continue
            if grep -rn "Vendor\\\\${NS[$other]}\\\\" "$ROOT/packages/backend/$pkg/src" 2>/dev/null; then
              echo "FAIL: $pkg импортирует внутренности $other" >&2; rc=1
            fi
          done
        done
        # 3) deep imports во frontend-пакетах: @vendor/<pkg>/src/... запрещены
        if grep -rn --include='*.ts' --include='*.tsx' -E "from ['\"]@vendor/[a-z-]+/src/" \
            "$ROOT/packages/frontend" "$ROOT/apps/chat-web/src" 2>/dev/null; then
          echo "FAIL: deep import @vendor/*/src/**" >&2; rc=1
        fi
        [[ $rc -eq 0 ]] && echo "boundaries: OK"
        exit $rc
        ;;
      *)
        echo "Unknown check: $sub" >&2; exit 64
        ;;
    esac
    ;;
  contracts)
    sub="${1:-}"; shift || true
    if [[ "$sub" == "validate" ]]; then
      php -r '
        $ok = true;
        foreach (glob($argv[1]."/packages/contracts/realtime/*.schema.json") as $f) {
            $data = json_decode((string) file_get_contents($f));
            if ($data === null) { fwrite(STDERR, "FAIL: $f\n"); $ok = false; continue; }
            foreach (["\$schema", "\$id", "title", "type", "required", "properties"] as $k) {
                if (!property_exists($data, $k)) { fwrite(STDERR, "FAIL: $f missing $k\n"); $ok = false; }
            }
            echo basename($f), ": OK\n";
        }
        exit($ok ? 0 : 1);
      ' "$ROOT"
    else
      echo "Unknown contracts command: $sub" >&2; exit 64
    fi
    ;;
  openapi)
    sub="${1:-}"; shift || true
    case "$sub" in
      build)
        (cd "$API_DIR" && php openapi/build.php)
        ;;
      validate)
        (cd "$API_DIR" && php openapi/build.php --check)
        php -r '
          $spec = json_decode((string) file_get_contents($argv[1]), true);
          if (!is_array($spec)) { fwrite(STDERR, "dist is not valid JSON\n"); exit(1); }
          foreach (["openapi", "info", "paths"] as $k) {
              if (!array_key_exists($k, $spec)) { fwrite(STDERR, "missing key: $k\n"); exit(1); }
          }
          if (!str_starts_with((string) $spec["openapi"], "3.1")) { fwrite(STDERR, "not OpenAPI 3.1\n"); exit(1); }
          foreach ($spec["paths"] as $p => $ops) {
              if (!str_starts_with($p, "/")) { fwrite(STDERR, "invalid path: $p\n"); exit(1); }
          }
          echo "openapi validate: OK\n";
        ' "$API_DIR/openapi/dist/openapi.json"
        ;;
      *)
        echo "Unknown openapi command: $sub" >&2; exit 64
        ;;
    esac
    ;;
  client)
    sub="${1:-}"; shift || true
    [[ "$sub" == "generate" ]] || { echo "Unknown client command: $sub" >&2; exit 64; }
    (cd "$ROOT/packages/frontend/api-client" && pnpm run generate)
    ;;
  compose)
    sub="${1:-}"; shift || true
    [[ "$sub" == "config" ]] || { echo "Unknown compose command: $sub" >&2; exit 64; }
    cd "$ROOT/infra/compose"
    envfile=".env"
    if [[ ! -f .env ]]; then
      cp .env.example .env.compose-check
      envfile=".env.compose-check"
    fi
    profiles="${1:-both}"
    rc=0
    if [[ "$profiles" == "prod" || "$profiles" == "both" ]]; then
      echo "== compose.prod.yaml =="
      DB_PASSWORD="${DB_PASSWORD:-check}" REDIS_PASSWORD="${REDIS_PASSWORD:-check}" \
      REVERB_APP_KEY="${REVERB_APP_KEY:-check}" TYPESENSE_API_KEY="${TYPESENSE_API_KEY:-check}" \
        docker compose --env-file "$envfile" -f compose.prod.yaml config -q && echo OK || rc=1
      echo "== compose.prod.yaml + s3 profile =="
      DB_PASSWORD="${DB_PASSWORD:-check}" REDIS_PASSWORD="${REDIS_PASSWORD:-check}" \
      REVERB_APP_KEY="${REVERB_APP_KEY:-check}" TYPESENSE_API_KEY="${TYPESENSE_API_KEY:-check}" \
        docker compose --env-file "$envfile" -f compose.prod.yaml --profile s3 config -q && echo OK || rc=1
    fi
    if [[ "$profiles" == "dev" || "$profiles" == "both" ]]; then
      echo "== compose.dev.yaml =="
      docker compose -f compose.dev.yaml config -q && echo OK || rc=1
    fi
    rm -f .env.compose-check
    exit $rc
    ;;
  build)
    sub="${1:-}"; shift || true
    [[ "$sub" == "images" ]] || { echo "Unknown build command: $sub" >&2; exit 64; }
    docker build -f "$ROOT/infra/docker/api/Dockerfile" -t vendor/chat-api:0.1.0 "$ROOT"
    docker build -f "$ROOT/infra/docker/web/Dockerfile" -t vendor/chat-web:0.1.0 "$ROOT"
    ;;
  supervisor)
    sub="${1:-}"; shift || true
    [[ "$sub" == "check" ]] || { echo "Unknown supervisor command: $sub" >&2; exit 64; }
    python3 - "$ROOT/infra/supervisor" <<'PY'
import configparser, glob, sys

root = sys.argv[1]
ok = True
required = {"autostart", "autorestart", "stopasgroup", "killasgroup", "user"}
for path in sorted(glob.glob(root + "/*.conf")):
    cp = configparser.ConfigParser(strict=True, interpolation=None)
    try:
        cp.read(path)
    except configparser.Error as e:
        print(f"FAIL {path}: {e}"); ok = False; continue
    for section in cp.sections():
        if section.startswith("program:"):
            missing = required - set(cp[section])
            if missing:
                print(f"FAIL {path} [{section}]: missing {sorted(missing)}"); ok = False
    print(f"OK   {path}")
sys.exit(0 if ok else 1)
PY
    ;;
  deploy)
    sub="${1:-}"; shift || true
    [[ "$sub" == "reload" ]] || { echo "Unknown deploy command: $sub" >&2; exit 64; }
    # Graceful reload после deploy: новый код подхватывается без drop'а трафика.
    # В Compose команды выполняются в работающих контейнерах; на Linux/VM — напрямую.
    if docker compose -p chat ps -q api >/dev/null 2>&1 && [[ -n "$(docker compose -p chat ps -q api 2>/dev/null)" ]]; then
      docker compose -p chat exec api php artisan octane:reload
      docker compose -p chat exec worker php artisan horizon:terminate
      docker compose -p chat exec reverb php artisan reverb:restart
    else
      (cd "$API_DIR" && php artisan octane:reload && php artisan horizon:terminate && php artisan reverb:restart)
    fi
    ;;
  smoke)
    sub="${1:-}"; shift || true
    if [[ "$sub" == "octane" ]]; then
      # Утечка identity между последовательными запросами одного FrankenPHP worker'а
      # (--workers=1): регистрируем двух пользователей, чередуем /me по их cookie.
      api_url="${CHAT_API_URL:-http://127.0.0.1:8000}"
      ref="${CHAT_SPA_REFERER:-http://127.0.0.1:8000}"
      jar_a=$(mktemp) jar_b=$(mktemp)
      suffix=$RANDOM$RANDOM
      xsrf() { # $1=jar → печатает актуальный XSRF-токен (url-декодированный)
        awk '$6 == "XSRF-TOKEN" {v=$7} END {print v}' "$1" | python3 -c 'import sys,urllib.parse; print(urllib.parse.unquote(sys.stdin.read().strip()))'
      }
      spa_post() { # $1=jar $2=path $3=json
        curl -fsS -b "$1" -c "$1" -X POST "$api_url$2" -H 'Content-Type: application/json' -H 'Accept: application/json' \
          -H "Referer: $ref" -H "X-XSRF-TOKEN: $(xsrf "$1")" -d "$3"
      }
      for jar in "$jar_a" "$jar_b"; do
        curl -fsS -c "$jar" "$api_url/sanctum/csrf-cookie" -H "Referer: $ref" -o /dev/null
      done
      spa_post "$jar_a" /api/v1/auth/register "{\"name\":\"Alice\",\"email\":\"alice$suffix@example.com\",\"password\":\"octane-smoke-pass1\"}" >/dev/null
      spa_post "$jar_b" /api/v1/auth/register "{\"name\":\"Bob\",\"email\":\"bob$suffix@example.com\",\"password\":\"octane-smoke-pass1\"}" >/dev/null
      rc=0
      for i in 1 2 3; do
        a=$(curl -fsS -b "$jar_a" -c "$jar_a" "$api_url/api/v1/me" -H 'Accept: application/json' -H "Referer: $ref" | grep -o '"name":"[^"]*"' | head -1)
        b=$(curl -fsS -b "$jar_b" -c "$jar_b" "$api_url/api/v1/me" -H 'Accept: application/json' -H "Referer: $ref" | grep -o '"name":"[^"]*"' | head -1)
        echo "round $i: A=$a B=$b"
        [[ "$a" == '"name":"Alice"' && "$b" == '"name":"Bob"' ]] || rc=1
      done
      rm -f "$jar_a" "$jar_b"
      [[ $rc -eq 0 ]] && echo "smoke octane: OK (no identity leak)" || echo "smoke octane: FAIL"
      exit $rc
    fi
    if [[ "$sub" == "websocket" ]]; then
      # Реальная доставка события: publish через pusher-протокол Reverb →
      # получение по WebSocket node-клиентом (pusher-js).
      ws_host="${REVERB_SMOKE_HOST:-127.0.0.1}" ws_port="${REVERB_SMOKE_PORT:-8080}"
      node "$ROOT/tools/smoke-websocket.mjs" "$ws_host" "$ws_port" &
      listener=$!
      sleep 2
      php -r '
        require $argv[1]."/apps/chat-api/vendor/autoload.php";
        $pusher = new Pusher\Pusher("devkey", "devsecret", "1001", [
            "host" => $argv[2], "port" => (int) $argv[3], "scheme" => "http", "useTLS" => false,
        ]);
        $pusher->trigger("smoke-channel", "smoke.event.v1", ["ok" => true, "sent_at" => date("c")]);
        echo "event published\n";
      ' "$ROOT" "$ws_host" "$ws_port"
      wait $listener
      exit $?
    fi
    [[ "$sub" == "runtime" ]] || { echo "Unknown smoke target: $sub" >&2; exit 64; }
    # Readiness против dev-стека: HTTP liveness/readiness API + компоненты из readiness payload.
    api_url="${CHAT_API_URL:-http://127.0.0.1:8000}"
    rc=0
    echo "== HTTP liveness =="
    curl -fsS -m 5 "$api_url/up" >/dev/null && echo "up: OK" || { echo "up: FAIL"; rc=1; }
    echo "== readiness =="
    body="$(curl -fsS -m 10 "$api_url/api/v1/readiness" || true)"
    echo "$body"
    [[ -n "$body" ]] || { echo "readiness: FAIL"; rc=1; }
    for compo in database redis queue websocket; do
      echo "$body" | grep -q "\"$compo\":{\"status\":\"ok\"" || { echo "$compo: not ok"; rc=1; }
    done
    [[ $rc -eq 0 ]] && echo "smoke runtime: OK"
    exit $rc
    ;;
  e2e)
    sub="${1:-realtime}"; shift || true
    # E2E-стек: postgres+redis (dev compose) + api/reverb/web + smoke-proxy,
    # Playwright — в официальном контейнере с браузерами (адрес внутри сети).
    CHAT_WS_HOST=proxy CHAT_WS_PORT=80 "$0" e2e-stack-up
    docker run --rm --network chat-dev_default -e E2E_BASE_URL=http://proxy -e CI=true       -v "$ROOT":/repo -v /home/dev/.local/share/pnpm/store/v3:/pnpm-store -w /repo/apps/chat-web       mcr.microsoft.com/playwright:v1.58.1-noble       bash -c "corepack enable >/dev/null 2>&1; corepack prepare pnpm@9.12.3 --activate >/dev/null 2>&1; pnpm exec playwright test e2e/$sub.spec.ts --reporter=line"
    rc=$?
    "$0" e2e-stack-down
    exit $rc
    ;;
  up)
    # Полный локальный стек для ручной проверки в браузере.
    "$0" e2e-stack-up
    ;;
  down)
    "$0" e2e-stack-down
    docker compose -f "$ROOT/infra/compose/compose.dev.yaml" down >/dev/null 2>&1 || true
    echo "stack down"
    ;;
  e2e-stack-up)
    docker compose -f "$ROOT/infra/compose/compose.dev.yaml" up -d postgres redis >/dev/null
    sleep 3
    APPKEY=$(cd "$API_DIR" && php artisan key:generate --show)
    common="-e APP_KEY=$APPKEY -e APP_ENV=production -e APP_DEBUG=false -e OCTANE_SERVER=frankenphp       -e DB_CONNECTION=pgsql -e DB_HOST=postgres -e DB_DATABASE=chat -e DB_USERNAME=chat -e DB_PASSWORD=chat       -e REDIS_HOST=redis -e CACHE_STORE=redis -e SESSION_DRIVER=redis -e QUEUE_CONNECTION=redis       -e SESSION_SECURE_COOKIE=false -e SANCTUM_STATEFUL_DOMAINS=proxy,localhost:${CHAT_LOCAL_PORT:-8088},127.0.0.1:${CHAT_LOCAL_PORT:-8088} -e CORS_ALLOWED_ORIGINS=http://proxy,http://localhost:${CHAT_LOCAL_PORT:-8088}       -e BROADCAST_CONNECTION=reverb -e REVERB_APP_ID=1001 -e REVERB_APP_KEY=devkey -e REVERB_APP_SECRET=devsecret       -e REVERB_SERVER_HOST=reverb -e REVERB_SERVER_PORT=8080 -e REVERB_HOST=reverb -e REVERB_PORT=8080       -e REVERB_SCHEME=http -e REVERB_ALLOWED_ORIGINS=*"
    docker rm -f e2e-api e2e-reverb e2e-worker e2e-web e2e-proxy >/dev/null 2>&1 || true
    docker run -d --name e2e-api --network chat-dev_default --network-alias api $common vendor/chat-api:0.1.0 >/dev/null
    docker run -d --name e2e-reverb --network chat-dev_default --network-alias reverb $common vendor/chat-api:0.1.0 php artisan reverb:start --host=0.0.0.0 --port=8080 >/dev/null
    # Broadcast'ы ставятся в очередь (QUEUE_CONNECTION=redis) — нужен worker.
    docker run -d --name e2e-worker --network chat-dev_default $common vendor/chat-api:0.1.0 php artisan queue:work --queue=default --tries=1 >/dev/null
    docker run -d --name e2e-web --network chat-dev_default --network-alias web       -e API_BASE_URL=/api/v1 -e REVERB_HOST="${CHAT_WS_HOST:-localhost}" -e REVERB_PORT="${CHAT_WS_PORT:-${CHAT_LOCAL_PORT:-8088}}" -e REVERB_SCHEME=http -e REVERB_APP_KEY=devkey       -e AI_ENABLED=false -e APP_NAME="E2E Chat" vendor/chat-web:0.1.0 >/dev/null
    docker run -d --name e2e-proxy --network chat-dev_default --network-alias proxy \
      -p "${CHAT_LOCAL_PORT:-8088}:80" \
      -v "$ROOT/infra/docker/proxy/Caddyfile.smoke:/etc/caddy/Caddyfile:ro" caddy:2.10.0-alpine >/dev/null
    sleep 6
    docker run --rm --network chat-dev_default $common vendor/chat-api:0.1.0 php artisan migrate --force >/dev/null
    echo "stack up: http://localhost:${CHAT_LOCAL_PORT:-8088} (proxy alias 'proxy' в сети chat-dev_default)"
    ;;
  e2e-stack-down)
    docker rm -f e2e-api e2e-reverb e2e-worker e2e-web e2e-proxy >/dev/null 2>&1 || true
    echo "e2e stack down"
    ;;
  lint)
    (cd "$ROOT" && ./vendor/bin/pint --test "$@")
    ;;
  stan)
    (cd "$ROOT" && apps/chat-api/vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G "$@")
    ;;
  ""|help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 64
    ;;
esac
